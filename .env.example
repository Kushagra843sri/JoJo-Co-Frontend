# Base URL of the deployed backend API, including the /api/v1 prefix. Left unset,
# api.js falls back to http://localhost:5000/api/v1 for local dev. MUST be set to
# the real backend URL (e.g. https://api.jojoandc0mpany.com/api/v1) in
# frontend/.env.production before deploying — see PRODUCTION_DEPLOYMENT.md.
VITE_API_URL=http://localhost:5000/api/v1

# From Cloudinary Dashboard > Settings > Upload — the cloud name is not secret,
# but the upload preset MUST be created as "Unsigned" (Settings > Upload > Upload presets)
# or the widget's uploads will be rejected.
VITE_CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
VITE_CLOUDINARY_UPLOAD_PRESET=<your-unsigned-upload-preset-name>

# 'sandbox' while testing, 'production' once CASHFREE_ENV on the backend is live —
# these two must always match or checkout will fail (see PRODUCTION_DEPLOYMENT.md).
VITE_CASHFREE_MODE=sandbox
